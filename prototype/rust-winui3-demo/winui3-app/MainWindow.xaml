<Window
    x:Class="WinUI3RustPrototype.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rust + WinUI 3 Prototype"
    Width="820"
    Height="600">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Rust + WinUI 3 Prototype" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Text="Connecting to backend..." FontSize="18" />
        <Button x:Name="PingButton" Content="Ping backend" Click="PingButton_Click" Width="180" />
        <TextBlock x:Name="ResponseText" Text="Waiting for response..." TextWrapping="WrapWholeWords" />
    </StackPanel>
</Window>
